# Copy to .env in the project root and fill in only what you use.
# Never commit .env or paste its values into a chat.

# --- AI provider (only if your tool does not already provide a session) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=

# --- Delivery ---
GDRIVE_REMOTE=gdrive
GDRIVE_FOLDER=Video Editor

# --- Local data (reel venv and models) ---
# VIDEO_EDITOR_DATA=$HOME/.local/share/video-editor

# --- Optional: Hyperframes / HeyGen cloud rendering ---
# HEYGEN_API_KEY=
# HYPERFRAMES_API_KEY=
# HEYGEN_ACCESS_TOKEN=

# --- Optional: ElevenLabs voiceover ---
# ELEVENLABS_API_KEY=
